root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Book text and notes; trailing spaces can be meaningful
[*.{txt,md}]
trim_trailing_whitespace = false
insert_final_newline = unset

[{*.yml,package.json,package-lock.json}]
indent_size = 2
